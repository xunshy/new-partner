# Vercel: required persistent Turso database (server-side only).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
# Optional: pin writes to your canonical origin. Omit for Vercel preview URLs.
# PUBLIC_ORIGIN=https://your-project.vercel.app
# Local development: omit TURSO_* to use the existing SQLite database.
# DATABASE_PATH=./data/partners.db
