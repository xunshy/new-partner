{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --global pnpm@11.19.0 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @new-partner/api exec -- tsc && pnpm --filter @new-partner/web build",
  "outputDirectory": ".",
  "functions": { "api/index.js": { "maxDuration": 30, "runtime": "nodejs22.x" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
