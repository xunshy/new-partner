{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "types": ["node"],
    "target": "ES2022",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmit": false,
    "declaration": true
