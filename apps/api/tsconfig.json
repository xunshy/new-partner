{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "types": ["node"],
    "target": "ES2022",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmit": false,
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["src/index.ts"]
}
